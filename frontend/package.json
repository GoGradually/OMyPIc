{
  "name": "omypic-frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:web": "vite",
    "dev": "tauri dev",
    "build": "vite build",
    "build:desktop": "tauri build",
    "build:desktop:win": "tauri build --bundles nsis",
    "build:desktop:mac": "tauri build --bundles dmg",
    "prepare:embedding": "node scripts/prepare-embedding.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.2",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^28.0.0",
    "kokoro-js": "1.2.1",
    "vite": "^5.4.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "kokoro-js": {
      "@huggingface/transformers": "$@huggingface/transformers"
    }
  }
}
